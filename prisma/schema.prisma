generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        String     @id @default(cuid())
  name      String
  // Slug estable para claves de permiso por categoría (contrato con Nómina).
  // Único entre todas las categorías; se autogenera del nombre.
  slug      String?    @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  // Orden de despliegue (raíces y subcategorías) — sigue el orden de los inventarios físicos.
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  dailyInventories DailyInventory[]

  @@index([parentId])
}

model Product {
  id           String               @id @default(cuid())
  categoryId   String?
  category     Category?            @relation(fields: [categoryId], references: [id])
  name         String
  unit         String
  currentStock Float                @default(0)
  minStock     Float                @default(0)
  imageUrl     String?
  // Control por nivel de botella (solo subcategoría Cócteles; null en el resto).
  // bottleLevel: "full" | "three_quarters" | "half" | "quarter" | "almost_empty"
  bottleLevel      String?
  reserveBottles   Int?
  // Umbral de alerta de compra; null = "almost_empty" por defecto.
  alertBottleLevel String?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  movements    StockMovement[]
  dailyItems   DailyInventoryItem[]

  @@index([categoryId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String
  quantity  Float
  notes     String?
  userId    String
  userName  String
  createdAt DateTime @default(now())

  // Trazabilidad de movimientos auto-generados por el inventario diario.
  // Movimientos manuales dejan ambos campos en null.
  // source: "daily_open_adjust" | "daily_nr_entry" | "daily_nr_exit" | "daily_close_adjust"
  dailyInventoryItemId String?
  source               String?

  @@unique([dailyInventoryItemId, source])
  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

model DailyInventory {
  id          String               @id @default(cuid())
  date        String               // "YYYY-MM-DD"
  // Categoría raíz de inventario a la que pertenece esta jornada.
  // NULL = registro legado/global anterior a la separación por categoría.
  categoryId  String?
  category    Category?            @relation(fields: [categoryId], references: [id])
  status      String               @default("open") // "open" | "closed"
  userId      String
  userName    String
  closedAt    DateTime?
  closedBy    String?
  reopenedAt    DateTime?
  reopenedBy    String?
  reopenReason  String?
  createdAt   DateTime             @default(now())
  items       DailyInventoryItem[]

  @@unique([date, categoryId])
  @@index([date])
  @@index([categoryId])
}

// Registro de auditoría liviano del módulo de inventario.
// Retención: 6 meses (se purga lo más antiguo en cada escritura).
model AuditLog {
  id           String   @id @default(cuid())
  action       String   // ej. "daily.open" | "daily.close" | "daily.reopen" | "daily.edit" | "category.create" | "category.permissions.autocreate" | "access.denied"
  entityType   String   // "DailyInventory" | "Category" | ...
  entityId     String?
  categoryId   String?
  categoryName String?
  userId       String
  userName     String
  summary      String   // descripción liviana y legible de la acción
  result       String   @default("success") // "success" | "denied"
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([categoryId])
}

model DailyInventoryItem {
  id               String         @id @default(cuid())
  dailyInventoryId String
  dailyInventory   DailyInventory @relation(fields: [dailyInventoryId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  initialCount     Float
  finalCount       Float?
  unregisteredEntry Float?
  unregisteredExit  Float?
  // Trazabilidad de la entrada no registrada: por qué no se registró y a qué hora ingresó.
  unregEntryReason String?
  unregEntryTime   String?       // "HH:MM"
  // Snapshot del control por botella al cierre de la jornada (solo ítems de cócteles).
  bottleLevel      String?
  reserveBottles   Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([dailyInventoryId, productId])
  @@index([dailyInventoryId])
}

// Solo presente en modo standalone
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  // Rol base: SUPERADMIN | ADMIN | EMPLOYEE
  role         String   @default("EMPLOYEE")
  // Rol personalizado opcional — si está presente, REEMPLAZA los permisos del rol base.
  customRoleId String?
  customRole   Role?    @relation(fields: [customRoleId], references: [id])
  // Overrides individuales sobre el conjunto resuelto (JSON string[] de claves de permiso).
  permsGrant   String   @default("[]")
  permsRevoke  String   @default("[]")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customRoleId])
}

// Roles personalizados (solo modo standalone). Conjuntos nombrados de permisos.
model Role {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  // Claves de permiso concedidas por el rol (JSON string[]).
  permissions String   @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}
