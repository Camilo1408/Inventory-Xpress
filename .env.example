# Modo de autenticación: "standalone" o "integrated"
AUTH_MODE=standalone

# JWT Secret — DEBE SER IDÉNTICO al de Nomina Xpress en modo integrated
NEXTAUTH_SECRET=cambia-esto-por-un-secreto-de-32-chars

# URL base de este sistema
NEXTAUTH_URL=http://localhost:3001

# Base de datos: SQLite local para dev, Turso para producción
TURSO_DATABASE_URL=file:./inventario.db
# TURSO_AUTH_TOKEN=         # Solo para Turso (producción)

# Solo en modo integrated — URL de Nomina Xpress
# NOMINA_APP_URL=http://localhost:3000
# NEXT_PUBLIC_NOMINA_APP_URL=http://localhost:3000

# Vercel Blob — para subir fotos de productos (opcional en dev)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Solo en producción (para cookie compartida entre subdominios)
# ROOT_DOMAIN=mirestaurante.com
